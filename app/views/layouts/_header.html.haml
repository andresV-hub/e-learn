-# Cabecera. styles.md §5 (layout) y §6.2 (píldoras de estado).
-# Los atributos son data-bs-* porque Bootstrap 5 no escucha los data-* de la 4:
-# con los antiguos, el menú desplegable y el botón hamburguesa no abrían.
%nav.navbar.navbar-expand-lg.navbar-dark.el-navbar
  .container
    = link_to root_path, class: 'navbar-brand d-flex align-items-center gap-2' do
      = image_tag 'logo.png', alt: 'E-Learn', height: 34
    %button.navbar-toggler{ type: 'button', 'data-bs-toggle': 'collapse', 'data-bs-target': '#mainNav',
                            'aria-controls': 'mainNav', 'aria-expanded': 'false', 'aria-label': 'Toggle navigation' }
      %span.navbar-toggler-icon

    #mainNav.collapse.navbar-collapse
      - if current_user
        %ul.navbar-nav.me-auto
          %li.nav-item
            = link_to courses_path, class: "nav-link #{'active' if current_page?(courses_path)}" do
              %i.fa.fa-graduation-cap{ 'aria-hidden': 'true' }
              Courses

        = search_form_for @ransack_courses, as: :courses_search, url: courses_path, html: { class: 'd-flex me-auto my-2 my-lg-0' } do |f|
          .input-group.input-group-sm
            = f.search_field :title_cont, class: 'form-control', placeholder: 'Find a course',
                             autocomplete: 'off', 'aria-label': 'Find a course'
            %button.btn.btn-light{ type: 'submit', 'aria-label': 'Search' }
              %i.fa.fa-search{ 'aria-hidden': 'true' }

        %ul.navbar-nav.ms-auto.align-items-lg-center
          - if current_user.has_role?(:student)
            %li.nav-item.dropdown
              %a#studentDropdown.nav-link.dropdown-toggle{ href: '#', role: 'button',
                                                           'data-bs-toggle': 'dropdown', 'aria-expanded': 'false' }
                %i.fa.fa-graduation-cap{ 'aria-hidden': 'true' }
                Learn
              %ul.dropdown-menu.dropdown-menu-end{ 'aria-labelledby': 'studentDropdown' }
                %li
                  = link_to purchased_courses_path, class: 'dropdown-item d-flex align-items-center gap-2' do
                    %i.fa.fa-graduation-cap{ 'aria-hidden': 'true' }
                    %span.flex-grow-1 Purchased courses
                    %span.el-pill.el-pill--info= current_user.enrollments_count
                %li
                  = link_to pending_review_courses_path, class: 'dropdown-item d-flex align-items-center gap-2' do
                    %i.fa.fa-star{ 'aria-hidden': 'true' }
                    %span.flex-grow-1 Pending review
                    %span.el-pill.el-pill--warning= current_user.enrollments.pending_review.count

          - if current_user.has_role?(:teacher)
            %li.nav-item.dropdown
              %a#teacherDropdown.nav-link.dropdown-toggle{ href: '#', role: 'button',
                                                           'data-bs-toggle': 'dropdown', 'aria-expanded': 'false' }
                %i.fa.fa-chalkboard-teacher{ 'aria-hidden': 'true' }
                Teach
              %ul.dropdown-menu.dropdown-menu-end{ 'aria-labelledby': 'teacherDropdown' }
                %li
                  = link_to new_course_path, class: 'dropdown-item d-flex align-items-center gap-2' do
                    %i.fa.fa-plus{ 'aria-hidden': 'true' }
                    %span.flex-grow-1 New course
                %li
                  = link_to created_courses_path, class: 'dropdown-item d-flex align-items-center gap-2' do
                    %i.fa.fa-graduation-cap{ 'aria-hidden': 'true' }
                    %span.flex-grow-1 My courses
                    %span.el-pill.el-pill--info= current_user.courses_count
                %li
                  = link_to my_students_enrollments_path, class: 'dropdown-item d-flex align-items-center gap-2' do
                    %i.fa.fa-users{ 'aria-hidden': 'true' }
                    %span.flex-grow-1 My students
                    %span.el-pill.el-pill--info= Enrollment.joins(:course).where(courses: { user: current_user }).count

          - if current_user.has_role?(:admin)
            %li.nav-item.dropdown
              %a#adminDropdown.nav-link.dropdown-toggle{ href: '#', role: 'button',
                                                         'data-bs-toggle': 'dropdown', 'aria-expanded': 'false' }
                %i.fa.fa-cog{ 'aria-hidden': 'true' }
                Admin
              %ul.dropdown-menu.dropdown-menu-end{ 'aria-labelledby': 'adminDropdown' }
                %li
                  = link_to unapproved_courses_path, class: 'dropdown-item d-flex align-items-center gap-2' do
                    %i.fa.fa-graduation-cap{ 'aria-hidden': 'true' }
                    %span.flex-grow-1 Waiting for review
                    -# Ámbar, no rojo: es trabajo pendiente, no un error (styles.md §6.2).
                    %span.el-pill.el-pill--warning= Course.unapproved.count
                %li
                  = link_to users_path, class: 'dropdown-item d-flex align-items-center gap-2' do
                    %i.fa.fa-users{ 'aria-hidden': 'true' }
                    %span.flex-grow-1 Users
                    %span.el-pill.el-pill--info= User.count
                %li
                  = link_to enrollments_path, class: 'dropdown-item d-flex align-items-center gap-2' do
                    %i.fa.fa-lock-open{ 'aria-hidden': 'true' }
                    %span.flex-grow-1 Enrollments
                    %span.el-pill.el-pill--info= Enrollment.count
                %li= link_to 'Activity', activity_path, class: 'dropdown-item'
                %li= link_to 'Tags', tags_path, class: 'dropdown-item'
                %li= link_to 'Analytics', analytics_path, class: 'dropdown-item'

          %li.nav-item.dropdown
            %a#accountDropdown.nav-link.dropdown-toggle.d-flex.align-items-center.gap-2{ href: '#', role: 'button',
                                                                                         'data-bs-toggle': 'dropdown', 'aria-expanded': 'false' }
              - if current_user.image?
                = image_tag current_user.image, size: '28x28', alt: '', class: 'rounded-circle'
              - else
                %i.fa.fa-user{ 'aria-hidden': 'true' }
              = current_user.username
            %ul.dropdown-menu.dropdown-menu-end{ 'aria-labelledby': 'accountDropdown' }
              %li= link_to 'My profile', user_path(current_user), class: 'dropdown-item'
              %li= link_to 'Account settings', edit_user_registration_path, class: 'dropdown-item'
              %li
                %hr.dropdown-divider
              %li
                = link_to 'Sign out', destroy_user_session_path, data: { turbo_method: :delete }, class: 'dropdown-item'

      - else
        %ul.navbar-nav.ms-auto.align-items-lg-center
          %li.nav-item
            = link_to 'Log in', new_user_session_path, class: "nav-link #{'active' if current_page?(new_user_session_path)}"
          %li.nav-item.ms-lg-2
            = link_to 'Sign up', new_user_registration_path, class: 'btn btn-primary btn-sm'
