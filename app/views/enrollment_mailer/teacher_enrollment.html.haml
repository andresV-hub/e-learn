%h1{ style: 'font-size: 20px; margin: 0 0 16px;' } You have a new student
%p{ style: 'margin: 0 0 20px;' }
  Someone just enrolled in
  = succeed '.' do
    = link_to @enrollment.course, course_url(@enrollment.course), style: 'color: #156c9c; font-weight: bold;'

%table{ role: 'presentation', width: '100%', cellpadding: '0', cellspacing: '0', style: 'font-size: 14px; border-top: 1px solid #e2e8f0;' }
  %tr
    %td{ style: 'padding: 8px 0; color: #64748b;' } Enrollment date
    %td{ style: 'padding: 8px 0; text-align: right;' }= @enrollment.created_at.strftime('%d %b %Y')
  %tr
    %td{ style: 'padding: 8px 0; color: #64748b;' } Enrollment ID
    %td{ style: 'padding: 8px 0; text-align: right;' }= @enrollment.slug
  %tr
    %td{ style: 'padding: 8px 0; color: #64748b;' } Course price
    %td{ style: 'padding: 8px 0; text-align: right;' }= number_to_currency(@enrollment.course.price)
  %tr
    %td{ style: 'padding: 8px 0; color: #64748b;' } Price paid
    %td{ style: 'padding: 8px 0; text-align: right;' }= number_to_currency(@enrollment.price)
  %tr
    %td{ style: 'padding: 8px 0; color: #64748b;' } Instructor
    %td{ style: 'padding: 8px 0; text-align: right;' }
      = mail_to @enrollment.course.user.email, @enrollment.course.user.username, style: 'color: #156c9c;'

%p{ style: 'margin: 24px 0 0; color: #64748b;' }
  = link_to 'The E-Learn team', root_url, style: 'color: #156c9c;'
