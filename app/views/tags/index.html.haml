- content_for :title do
  E-Learn | Tags

%header.el-page-header
  .el-page-header__lead
    %span.el-page-header__eyebrow Admin
    %h1.el-page-header__title
      Tags
      %span.el-pill.el-pill--info= @tags.count

%section.el-panel
  - if @tags.any?
    .table-responsive
      %table.table.table-hover.align-middle.mb-0
        %thead
          %tr
            %th Tag
            %th.text-end Courses
            %th.text-end Actions
        %tbody
          - @tags.each do |tag|
            %tr
              %td
                = link_to courses_path(courses_search: { course_tags_tag_id_eq: tag.id }), class: 'el-pill el-pill--info' do
                  = tag.name
              %td.text-end= tag.course_tags_count
              %td.text-end
                = link_to tag, data: { turbo_method: :delete, turbo_confirm: "Delete the tag “#{tag.name}”? This can't be undone." },
                          class: 'btn btn-sm btn-outline-danger', title: 'Delete tag' do
                  %i.fa.fa-trash{ 'aria-hidden': 'true' }
                  %span.visually-hidden Delete tag
  - else
    .el-panel__body
      .el-empty
        %i.el-empty__icon.fa.fa-tags{ 'aria-hidden': 'true' }
        .el-empty__title No tags yet
        %p.mb-0 Tags appear as teachers add them to their courses.
