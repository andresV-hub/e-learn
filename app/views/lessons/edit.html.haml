- content_for :title do
  E-Learn | #{@course.title} | Editing #{@lesson.title}

%nav{ 'aria-label': 'Breadcrumb' }
  %ol.breadcrumb
    %li.breadcrumb-item= link_to 'Courses', courses_path
    %li.breadcrumb-item= link_to @lesson.course.title, course_path(@lesson.course)
    %li.breadcrumb-item= link_to @lesson.title, course_lesson_path(@course, @lesson)
    %li.breadcrumb-item.active{ 'aria-current': 'page' } Edit

.row.justify-content-center
  .col-lg-9
    %header.el-page-header
      .el-page-header__lead
        %span.el-page-header__eyebrow Teach
        %h1.el-page-header__title= @lesson.title
      .el-page-header__actions
        = link_to 'View lesson', course_lesson_path(@course, @lesson), class: 'btn btn-outline-primary btn-sm'
        = link_to 'Back to course', course_path(@lesson.course), class: 'btn btn-outline-primary btn-sm'

    %section.el-panel
      .el-panel__body
        = render 'form'
