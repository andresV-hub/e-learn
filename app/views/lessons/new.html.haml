- content_for :title do
  E-Learn | #{@course.title} | New lesson

%nav{ 'aria-label': 'Breadcrumb' }
  %ol.breadcrumb
    %li.breadcrumb-item= link_to 'Courses', courses_path
    %li.breadcrumb-item= link_to @course.title, course_path(@course)
    %li.breadcrumb-item.active{ 'aria-current': 'page' } New lesson

.row.justify-content-center
  .col-lg-9
    %header.el-page-header
      .el-page-header__lead
        %span.el-page-header__eyebrow Teach
        %h1.el-page-header__title New lesson
      .el-page-header__actions
        = link_to 'Back to course', course_path(@course), class: 'btn btn-outline-primary btn-sm'

    %section.el-panel
      .el-panel__body
        = render 'form'
