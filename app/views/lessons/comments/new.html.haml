- content_for :title do
  E-Learn | New comment

.row.justify-content-center
  .col-lg-7
    %header.el-page-header
      .el-page-header__lead
        %span.el-page-header__eyebrow Comment
        %h1.el-page-header__title= @lesson.title
      .el-page-header__actions
        = link_to 'Back to lesson', course_lesson_path(@course, @lesson), class: 'btn btn-outline-primary btn-sm'

    %section.el-panel
      .el-panel__body
        = render 'lessons/comments/form'
