-# Lección. styles.md §6.9 (vídeo) y §6.4 (panel).
-# La etiqueta %video se conserva tal cual: application.js le engancha el
-# bloqueo del menú contextual ($("video").bind("contextmenu", ...)).
%section.el-panel
  .el-panel__head.d-flex.flex-wrap.align-items-center.gap-2
    %h2.flex-grow-1
      %span.el-lesson-list__index= lesson.row_order_rank + 1
      = lesson.title
    - if current_user && lesson.viewed(current_user)
      %span.el-pill.el-pill--success
        %i.fa.fa-check{ 'aria-hidden': 'true' }
        Completed

  - if policy(lesson).show?
    - if @lesson.video.attached?
      .el-video
        - if @lesson.video_thumbnail.attached?
          %video{ controls: true, width: '100%', preload: 'metadata', controlslist: 'nodownload',
                  poster: url_for(@lesson.video_thumbnail) }
            %source{ src: rails_blob_url(@lesson.video), type: @lesson.video.content_type }
        - else
          %video{ controls: true, width: '100%', preload: 'metadata', controlslist: 'nodownload' }
            %source{ src: rails_blob_url(@lesson.video), type: @lesson.video.content_type }

    .el-panel__body
      .el-prose= lesson.content

      - if policy(lesson).edit?
        .d-flex.flex-wrap.gap-2.mt-4.pt-3.border-top
          = link_to edit_course_lesson_path(@course, lesson), class: 'btn btn-sm btn-outline-primary' do
            %i.fa.fa-edit{ 'aria-hidden': 'true' }
            Edit lesson
          = link_to [@course, lesson], data: { turbo_method: :delete, turbo_confirm: "Delete “#{lesson.title}”? This can't be undone." },
                    class: 'btn btn-sm btn-outline-danger' do
            %i.fa.fa-trash{ 'aria-hidden': 'true' }
            Delete
  - else
    .el-panel__body
      .el-empty
        %i.el-empty__icon.fa.fa-lock{ 'aria-hidden': 'true' }
        .el-empty__title Enroll to watch this lesson
        = link_to 'See the course', course_path(@course), class: 'btn btn-primary mt-2'

  -# Navegación entre lecciones: anterior a la izquierda, siguiente a la derecha.
  - if lesson.prev || lesson.next
    .el-panel__head.d-flex.justify-content-between.gap-2
      - if lesson.prev
        = link_to course_lesson_path(@course, lesson.prev), class: 'btn btn-sm btn-outline-primary' do
          %i.fa.fa-arrow-left{ 'aria-hidden': 'true' }
          Previous
      - else
        %span
      - if lesson.next
        = link_to course_lesson_path(@course, lesson.next), class: 'btn btn-sm btn-primary' do
          Next
          %i.fa.fa-arrow-right{ 'aria-hidden': 'true' }
