-# Ficha de usuario. Usa siempre la variable local `user`: antes mezclaba `user`
-# y `@user`, así que el partial solo funcionaba desde users#show.
%section.el-panel
  .el-panel__body
    .d-flex.align-items-center.gap-3.mb-3
      - if user.image?
        = image_tag user.image, size: '64x64', alt: '', class: 'rounded-circle'
      - else
        %i.fa.fa-user.fa-2x.text-muted{ 'aria-hidden': 'true' }
      %div
        %h1.h4.mb-1= user.username
        %p.el-meta.mb-0
          - if user.online?
            %span.el-pill.el-pill--success Online
          - else
            %span.el-pill.el-pill--muted Offline
          = "Joined #{time_ago_in_words(user.created_at)} ago"

    - if user.roles.any?
      .d-flex.flex-wrap.gap-1.mb-3
        - user.roles.each do |role|
          %span.el-pill.el-pill--info= role.name

    .row.g-3.text-center
      .col-6.col-md-3
        .el-stat
          .el-stat__value= user.courses_count
          .el-stat__label Courses
      .col-6.col-md-3
        .el-stat
          .el-stat__value= user.enrollments_count
          .el-stat__label Enrollments
      .col-6.col-md-3
        .el-stat
          .el-stat__value= user.comments_count
          .el-stat__label Comments
      .col-6.col-md-3
        .el-stat
          .el-stat__value= user.user_lessons_count
          .el-stat__label Lessons seen

    - if user == current_user && user.uid.nil?
      .mt-4.pt-3.border-top
        = link_to user_google_oauth2_omniauth_authorize_path, data: { turbo_method: :post }, class: 'el-social__btn w-auto d-inline-flex' do
          %i.fab.fa-google{ 'aria-hidden': 'true' }
          Sync with Google
