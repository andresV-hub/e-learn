-# frozen_string_literal: true
= simple_form_for(@enrollment) do |f|
  = f.error_notification
  = f.error_notification message: f.object.errors[:base].to_sentence if f.object.errors[:base].present?

  = f.input :rating, collection: 1..5, as: :radio_buttons, label: 'Your rating',
            item_wrapper_class: 'form-check form-check-inline'
  = f.input :review, label: 'Your review', placeholder: 'What did you learn? Would you recommend it?'

  = f.button :submit, 'Save review', class: 'btn btn-primary'
