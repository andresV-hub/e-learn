- content_for :title do
  E-Learn | Rate #{@enrollment.course.title}

.row.justify-content-center
  .col-lg-7
    %header.el-page-header
      .el-page-header__lead
        %span.el-page-header__eyebrow Review
        %h1.el-page-header__title Rate this course
      .el-page-header__actions
        = link_to 'Back to course', course_path(@enrollment.course), class: 'btn btn-outline-primary btn-sm'

    %section.el-panel
      .el-panel__body
        %p.el-meta.mb-4
          %i.fa.fa-graduation-cap{ 'aria-hidden': 'true' }
          = @enrollment.course.title
        = render 'form'
