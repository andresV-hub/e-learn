-# Certificado. docs/imagen-de-marca.md §9: es la pieza que el alumno descarga y
-# enseña, así que lleva el logotipo real (no logo_blue.png, que es un borrador
-# de una taza de café), navy sobre blanco y sin fondos oscuros que arruinen la
-# impresión. Los estilos van en línea porque wkhtmltopdf no comparte la hoja de
-# la aplicación, y la maquetación va con tablas porque su motor (WebKit antiguo)
-# no soporta flexbox ni grid de forma fiable.
- ink = '#2a4054'
- blue = '#21a8f4'
- soft = '#64748b'

%div{ style: "border: 8px solid #{blue}; padding: 6px; height: 100%; box-sizing: border-box;" }
  %table{ role: 'presentation', width: '100%', height: '100%', cellpadding: '0', cellspacing: '0',
          style: "border: 2px solid #{ink}; font-family: Helvetica, Arial, sans-serif; color: #{ink};" }
    %tr
      %td{ valign: 'middle', align: 'center', height: '100%', style: 'padding: 40px 60px 0;' }

        %div{ style: "text-transform: uppercase; letter-spacing: 5px; font-size: 13px; color: #{soft};" }
          Certificate of completion

        %div{ style: 'font-size: 42px; font-weight: bold; letter-spacing: -1px; margin: 20px 0 36px;' }
          = @enrollment.course.title

        %div{ style: "font-size: 15px; color: #{soft};" } This certifies that
        %div{ style: 'font-size: 30px; font-weight: bold; margin: 8px 0 4px;' }
          = @enrollment.user.username
        %div{ style: "font-size: 12px; color: #{soft};" }
          = @enrollment.user.email

        %div{ style: "font-size: 15px; color: #{soft}; margin-top: 28px;" }
          has successfully completed this course, taught by
        %div{ style: 'font-size: 19px; font-weight: bold; margin-top: 4px;' }
          = @enrollment.course.user.username

    %tr
      %td{ valign: 'bottom', style: 'padding: 0 40px 28px;' }
        %div{ style: 'border-top: 1px solid #e2e8f0; padding-top: 16px;' }
          %table{ role: 'presentation', width: '100%', cellpadding: '0', cellspacing: '0',
                  style: "font-size: 11px; color: #{soft};" }
            %tr
              %td{ width: '33%', align: 'left', valign: 'top' }
                %strong{ style: "color: #{ink};" } Completed
                %br
                = @enrollment.updated_at.strftime('%d %B %Y')
              %td{ width: '34%', align: 'center', valign: 'top' }
                = image_tag wicked_pdf_asset_base64('logo.png'), height: '30', width: 'auto', alt: 'E-Learn'
                %br
                e-learn-go.herokuapp.com
              %td{ width: '33%', align: 'right', valign: 'top' }
                %strong{ style: "color: #{ink};" } Certificate ID
                %br
                = @enrollment.slug
