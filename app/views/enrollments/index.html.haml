- content_for :title do
  E-Learn | All enrollments

-# styles.md §6.7: tabla dentro de panel, siempre en .table-responsive.
%header.el-page-header
  .el-page-header__lead
    %span.el-page-header__eyebrow Admin
    %h1.el-page-header__title
      Enrollments
      %span.el-pill.el-pill--info= @enrollments.count

%section.el-panel
  .el-panel__body.el-filters
    = search_form_for @q, url: @ransack_path do |f|
      .row.g-2.align-items-end
        .col-md-3
          = f.label :user_email_cont, 'Student'
          = f.search_field :user_email_cont, class: 'form-control', placeholder: 'User email'
        .col-md-3
          = f.label :course_title_cont, 'Course'
          = f.search_field :course_title_cont, class: 'form-control', placeholder: 'Course title'
        .col-md-2
          = f.label :course_user_email_cont, 'Teacher'
          = f.search_field :course_user_email_cont, class: 'form-control', placeholder: 'Teacher'
        .col-md-2
          = f.label :price_eq, 'Price'
          = f.search_field :price_eq, class: 'form-control', placeholder: 'Price'
        .col-md-2
          = f.label :rating_eq, 'Rating'
          = f.search_field :rating_eq, class: 'form-control', placeholder: 'Rating'
      .d-flex.gap-2.mt-3
        = f.submit 'Search', class: 'btn btn-primary'
        = link_to 'Clear filters', @ransack_path, class: 'btn btn-link'

%section.el-panel
  - if @enrollments.any?
    .table-responsive
      %table.table.table-hover.align-middle.mb-0
        %thead
          %tr
            %th= sort_link(@q, :user_email, 'Student')
            %th= sort_link(@q, :created_at, 'Enrolled')
            %th= sort_link(@q, :course_title, 'Course')
            %th Teacher
            %th.text-end= sort_link(@q, :price, 'Price')
            %th= sort_link(@q, :rating, 'Rating')
            %th Review
            %th.text-end Progress
            %th.text-end Actions
        %tbody
          - @enrollments.each do |enrollment|
            %tr
              %td= link_to enrollment.user, user_path(enrollment.user)
              %td.el-meta= enrollment.created_at.strftime('%d/%b/%Y')
              %td= link_to enrollment.course, course_path(enrollment.course)
              %td= link_to enrollment.course.user, user_path(enrollment.course.user)
              %td.text-end= number_to_currency(enrollment.price)
              %td
                - if enrollment.rating.present?
                  %span.el-rating
                    %i.fa.fa-star{ 'aria-hidden': 'true' }
                    %span.el-rating__value= enrollment.rating
                - else
                  %span.el-pill.el-pill--muted Not rated
              %td.el-meta= truncate(enrollment.review, length: 60)
              - progress = enrollment.course.progress(enrollment.user).to_i
              %td.text-end
                %span{ class: "el-pill #{progress == 100 ? 'el-pill--success' : 'el-pill--muted'}" }
                  = "#{progress}%"
              %td.text-end
                .d-flex.gap-1.justify-content-end
                  = link_to enrollment, class: 'btn btn-sm btn-outline-primary', title: 'See review' do
                    %i.fa.fa-eye{ 'aria-hidden': 'true' }
                    %span.visually-hidden See review
                  - if progress == 100
                    = link_to certificate_enrollment_path(enrollment, format: :pdf), class: 'btn btn-sm btn-outline-primary', title: 'Certificate' do
                      %i.fa.fa-file-pdf{ 'aria-hidden': 'true' }
                      %span.visually-hidden Certificate
                  - if policy(enrollment).edit?
                    = link_to edit_enrollment_path(enrollment), class: 'btn btn-sm btn-outline-primary', title: 'Edit review' do
                      %i.fa.fa-star{ 'aria-hidden': 'true' }
                      %span.visually-hidden Edit review
                  - if policy(enrollment).destroy?
                    = link_to enrollment, data: { turbo_method: :delete, turbo_confirm: "Delete this enrollment? This can't be undone." },
                              class: 'btn btn-sm btn-outline-danger', title: 'Delete' do
                      %i.fa.fa-trash{ 'aria-hidden': 'true' }
                      %span.visually-hidden Delete

    .el-panel__body
      != @pagy.series_nav(:bootstrap)
  - else
    .el-panel__body
      .el-empty
        %i.el-empty__icon.fa.fa-lock-open{ 'aria-hidden': 'true' }
        .el-empty__title No enrollments match that search
        = link_to 'Clear filters', @ransack_path, class: 'btn btn-outline-primary mt-2'
