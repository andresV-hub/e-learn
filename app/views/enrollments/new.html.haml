- content_for :title do
  E-Learn | Enroll in #{@course.title}

-# Confirmación de compra. styles.md §6.3: el botón dice qué hace y cuánto cuesta.
.row.justify-content-center
  .col-lg-6
    %header.el-page-header
      .el-page-header__lead
        %span.el-page-header__eyebrow Enrollment
        %h1.el-page-header__title Confirm your enrollment

    %section.el-panel
      .el-panel__body
        %h2.mb-1= link_to @course.title, course_path(@course)
        %p.el-meta
          %i.fa.fa-chalkboard-teacher{ 'aria-hidden': 'true' }
          = @course.user.username

        %dl.row.mb-4
          %dt.col-6.el-meta Lessons
          %dd.col-6.text-end= @course.lessons_count
          %dt.col-6.el-meta Level
          %dd.col-6.text-end= @course.level
          %dt.col-6.el-meta Language
          %dd.col-6.text-end= @course.language
          %dt.col-6 Total
          %dd.col-6.text-end.el-course-card__price
            = @course.price.positive? ? number_to_currency(@course.price) : 'Free'

        = form_tag course_enrollments_path(@course) do
          - label = @course.price.positive? ? "Pay #{number_to_currency(@course.price)}" : 'Enroll for free'
          = submit_tag label, class: 'btn btn-primary btn-lg w-100'

        = link_to 'Back to course', course_path(@course), class: 'btn btn-link w-100 mt-2'
