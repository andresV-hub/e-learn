- content_for :title do
  E-Learn | Activity

%header.el-page-header
  .el-page-header__lead
    %span.el-page-header__eyebrow Admin
    %h1.el-page-header__title
      Activity
      %span.el-pill.el-pill--info= @activities.count

%section.el-panel
  - if @activities.any?
    %ul.el-lesson-list
      - @activities.each do |activity|
        %li.el-lesson-list__item.align-items-start
          %i.fa.fa-bell.text-muted.mt-1{ 'aria-hidden': 'true' }
          .flex-grow-1
            %div
              %span.el-pill.el-pill--muted= model_label(activity.trackable_type)
              %span.ms-1= crud_label(activity.key.match(/\.(.*)/)[1])
              -# Un curso borrado deja su actividad "destroy" apuntando a nada,
              -# igual que las lecciones y los comentarios: sin comprobarlo,
              -# borrar un curso tumbaba esta página entera.
              - if activity.trackable_type == 'Lesson'
                - if Lesson.where(id: activity.trackable_id).present?
                  = link_to activity.trackable, course_lesson_path(activity.trackable.course, activity.trackable)
                - else
                  %span.el-meta (deleted)
              - elsif activity.trackable_type == 'Comment'
                - if Comment.where(id: activity.trackable_id).any?
                  = link_to truncate(activity.trackable.content, length: 60), course_lesson_path(activity.trackable.lesson.course, activity.trackable.lesson)
                - else
                  %span.el-meta (deleted)
              - elsif activity.trackable.present?
                = link_to activity.trackable, activity.trackable
              - else
                %span.el-meta (deleted)
            -# Las altas hechas fuera de una petición (seeds, consola, tareas)
            -# no tienen usuario al que atribuirlas.
            %div.el-meta
              by
              - if activity.owner.present?
                = link_to activity.owner, user_path(activity.owner)
              - else
                the system
              ·
              = "#{time_ago_in_words(activity.created_at)} ago"

    .el-panel__body
      != @pagy.series_nav(:bootstrap)
  - else
    .el-panel__body
      .el-empty
        %i.el-empty__icon.fa.fa-bell{ 'aria-hidden': 'true' }
        .el-empty__title Nothing has happened yet
