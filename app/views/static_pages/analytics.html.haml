- content_for :title do
  E-Learn | Analytics

-# styles.md §5: un gráfico por panel, dos columnas en lg+.
%header.el-page-header
  .el-page-header__lead
    %span.el-page-header__eyebrow Admin
    %h1.el-page-header__title Analytics

.row.g-4
  .col-lg-6
    %section.el-panel.h-100
      .el-panel__head
        %h2 New users per day
      .el-panel__body
        = line_chart charts_users_per_day_path, colors: ['#156c9c']
  .col-lg-6
    %section.el-panel.h-100
      .el-panel__head
        %h2 New enrollments per day
      .el-panel__body
        = column_chart charts_enrollments_per_day_path, colors: ['#21a8f4']
  .col-lg-6
    %section.el-panel.h-100
      .el-panel__head
        %h2 Most enrolled courses
      .el-panel__body
        = bar_chart charts_course_popularity_path, colors: ['#4db9f6']
  .col-lg-6
    %section.el-panel.h-100
      .el-panel__head
        %h2 Top earning courses
      .el-panel__body
        = column_chart charts_money_makers_path, colors: ['#15803d']
