- content_for :title do
  E-Learn | Online Courses - Learn what you want

-# Portada. styles.md §5 (layout) y §6 (hero, estadísticas, tarjeta de curso).
-# La rejilla usa row/col: .card-columns era de Bootstrap 4 y no existe en la 5,
-# así que las tarjetas se apilaban en una sola columna.

%section.el-hero.mb-5
  .text-center
    %h1.el-display.el-hero__title What do you want to learn today?
    %p.el-hero__lead.mb-4 Browse courses taught by people who do the work.

    - if current_user
      = search_form_for @ransack_courses, as: :courses_search, url: courses_path, html: { class: 'mx-auto', style: 'max-width: 34rem;' } do |f|
        .input-group.input-group-lg
          = f.search_field :title_cont, class: 'form-control', placeholder: 'Find a course',
                           autocomplete: 'off', 'aria-label': 'Find a course'
          %button.btn.btn-primary{ type: 'submit' }
            %i.fa.fa-search{ 'aria-hidden': 'true' }
            %span.ms-1 Search
    - else
      .d-flex.flex-wrap.justify-content-center.gap-2.mb-4
        = link_to 'Get started', new_user_registration_path, class: 'btn btn-primary btn-lg'
        = link_to 'Log in', new_user_session_path, class: 'btn btn-outline-light btn-lg'

      .d-flex.flex-wrap.justify-content-center.gap-2
        = link_to user_google_oauth2_omniauth_authorize_path, data: { turbo_method: :post }, class: 'el-social__btn w-auto' do
          %i.fab.fa-google{ 'aria-hidden': 'true' }
          Continue with Google
        = link_to user_github_omniauth_authorize_path, data: { turbo_method: :post }, class: 'el-social__btn w-auto' do
          %i.fab.fa-github{ 'aria-hidden': 'true' }
          Continue with GitHub
        = link_to user_facebook_omniauth_authorize_path, data: { turbo_method: :post }, class: 'el-social__btn w-auto' do
          %i.fab.fa-facebook{ 'aria-hidden': 'true' }
          Continue with Facebook

%section.row.g-3.mb-5
  .col-6.col-lg-3
    .el-stat
      %i.el-stat__icon.fa.fa-graduation-cap{ 'aria-hidden': 'true' }
      .el-stat__value= Course.approved.published.count
      .el-stat__label Online courses
  .col-6.col-lg-3
    .el-stat
      %i.el-stat__icon.fa.fa-chalkboard-teacher{ 'aria-hidden': 'true' }
      .el-stat__value= Course.distinct.count(:user_id)
      .el-stat__label Expert instructors
  .col-6.col-lg-3
    .el-stat
      %i.el-stat__icon.fa.fa-user-graduate{ 'aria-hidden': 'true' }
      .el-stat__value= User.count
      .el-stat__label Active learners
  .col-6.col-lg-3
    .el-stat
      %i.el-stat__icon.fa.fa-infinity{ 'aria-hidden': 'true' }
      .el-stat__value Lifetime
      .el-stat__label Access, on your schedule

- if current_user && @purchased_courses.any?
  %section.mb-5
    %header.el-page-header
      %h2.el-page-header__title
        %i.fa.fa-user-graduate{ 'aria-hidden': 'true' }
        Continue learning
      .el-page-header__actions
        = link_to 'All my courses', purchased_courses_path, class: 'btn btn-outline-primary btn-sm'
    .row.row-cols-1.row-cols-sm-2.row-cols-lg-3.g-4
      - @purchased_courses.each do |course|
        .col= render 'courses/course', course: course

%section.mb-5
  %header.el-page-header
    %h2.el-page-header__title
      %i.fa.fa-chart-line{ 'aria-hidden': 'true' }
      Popular courses
    .el-page-header__actions
      = link_to 'See more', courses_path(courses_search: { s: 'enrollments_count desc' }), class: 'btn btn-outline-primary btn-sm'
  .row.row-cols-1.row-cols-sm-2.row-cols-lg-3.g-4
    - @popular.each do |course|
      .col= render 'courses/course', course: course

%section.mb-5
  %header.el-page-header
    %h2.el-page-header__title
      %i.fa.fa-star{ 'aria-hidden': 'true' }
      Top rated courses
    .el-page-header__actions
      = link_to 'See more', courses_path(courses_search: { s: 'average_rating desc' }), class: 'btn btn-outline-primary btn-sm'
  .row.row-cols-1.row-cols-sm-2.row-cols-lg-3.g-4
    - @top_rated.each do |course|
      .col= render 'courses/course', course: course

%section.mb-5
  %header.el-page-header
    %h2.el-page-header__title
      %i.fa.fa-clock{ 'aria-hidden': 'true' }
      Latest courses
    .el-page-header__actions
      = link_to 'See more', courses_path(courses_search: { s: 'created_at desc' }), class: 'btn btn-outline-primary btn-sm'
  .row.row-cols-1.row-cols-sm-2.row-cols-lg-3.g-4
    - @latest.each do |course|
      .col= render 'courses/course', course: course

- if @popular_tags.any?
  %section.mb-5
    %h2.mb-3
      %i.fa.fa-tags{ 'aria-hidden': 'true' }
      Most popular tags
    .d-flex.flex-wrap.gap-2
      - @popular_tags.each do |tag|
        = link_to courses_path(courses_search: { course_tags_tag_id_eq: tag.id }), class: 'el-pill el-pill--info' do
          = tag.name
          %span.opacity-75= tag.course_tags_count

- if @latest_good_reviews.any?
  %section
    %h2.mb-3
      %i.fa.fa-comment{ 'aria-hidden': 'true' }
      What our students have to say
    .row.row-cols-1.row-cols-md-2.row-cols-lg-3.g-4
      - @latest_good_reviews.each do |enrollment|
        .col= render 'enrollments/enrollment', enrollment: enrollment
