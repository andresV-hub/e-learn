= render layout: 'courses/course_wizard/step' do
  = simple_form_for @course, url: course_course_wizard_path, method: :put do |f|
    -# #lessons y .links son la estructura que espera cocoon-js para insertar
    -# los campos nuevos: no reorganizar.
    #lessons
      = f.simple_fields_for :lessons do |lesson|
        = render 'lesson_fields', f: lesson
      .links.mb-3
        = link_to_add_association 'Add lesson', f, :lessons, class: 'btn btn-outline-primary btn-sm'

    = f.button :submit, 'Save and continue', class: 'btn btn-primary'
