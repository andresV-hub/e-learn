= render layout: 'courses/course_wizard/step' do
  = simple_form_for @course, url: course_course_wizard_path, method: :put do |f|
    = f.input :language, collection: Course.languages, include_blank: true, as: :radio_buttons,
              item_wrapper_class: 'form-check form-check-inline'
    = f.input :level, collection: Course.levels, include_blank: true, as: :radio_buttons,
              item_wrapper_class: 'form-check form-check-inline'
    = f.input :price, collection: [0, 9, 19, 49, 99, 149, 199], as: :radio_buttons,
              item_wrapper_class: 'form-check form-check-inline'

    .mb-3
      = f.label :tag_ids, 'Tags'
      -# .selectize-tags es hook de application.js: NO renombrar.
      = f.select :tag_ids, @tags.all.pluck(:name, :id), {}, { multiple: true, class: 'selectize-tags' }

    = f.button :submit, 'Save and continue', class: 'btn btn-primary'
