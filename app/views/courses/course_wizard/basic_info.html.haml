= render layout: 'courses/course_wizard/step' do
  = simple_form_for @course, url: course_course_wizard_path, method: :put do |f|
    = f.input :title, input_html: { autocomplete: 'off' }

    - if @course.avatar.attached?
      .mb-3
        .el-course-card__cover.rounded{ style: 'max-width: 20rem;' }
          = image_tag @course.avatar, alt: @course.title
        %p.el-meta.mt-1= @course.avatar.filename
    = f.input :avatar, hint: 'PNG or JPEG, up to 500 KB. Shown as 16:9 in the catalog.'

    = f.input :description, as: :rich_text_area
    = f.input :short_description, hint: 'Up to 300 characters. This is what shows in the catalog.'

    = f.button :submit, 'Save and continue', class: 'btn btn-primary'
