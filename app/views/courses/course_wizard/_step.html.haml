- content_for :title do
  E-Learn | Editing #{@course.title}

-# Plantilla del asistente. styles.md §6.13.
-# El indicador de pasos sustituye a las dos barras .progress que se pintaban
-# con el mismo ancho y no reflejaban el avance real.
%nav{ 'aria-label': 'Breadcrumb' }
  %ol.breadcrumb
    %li.breadcrumb-item= link_to 'Courses', courses_path
    %li.breadcrumb-item= link_to @course.title, course_path(@course)
    %li.breadcrumb-item.active{ 'aria-current': 'page' } Edit

.row.justify-content-center
  .col-lg-9
    %header.el-page-header
      .el-page-header__lead
        %span.el-page-header__eyebrow
          = "Step #{wizard_steps.index(step) + 1} of #{wizard_steps.count}"
        %h1.el-page-header__title= step.to_s.humanize

    %ol.el-steps.mb-4
      - wizard_steps.each_with_index do |s, i|
        - current = current_page?(course_course_wizard_path(@course, s))
        - done = i < wizard_steps.index(step)
        %li.el-steps__item{ class: [('el-steps__item--current' if current), ('el-steps__item--done' if done && !current)].compact }
          = link_to course_course_wizard_path(@course, s), class: 'd-flex align-items-center gap-2 text-reset text-decoration-none' do
            %span.el-steps__index
              - if done && !current
                %i.fa.fa-check{ 'aria-hidden': 'true' }
              - else
                = i + 1
            %span= s.to_s.humanize

    %section.el-panel
      .el-panel__body
        - if @course.errors.any?
          .alert.alert-danger{ role: 'alert' }
            %ul.mb-0
              - @course.errors.full_messages.each do |msg|
                %li= msg

        = yield

    .d-flex.justify-content-between.gap-2
      = link_to previous_wizard_path, class: 'btn btn-outline-primary' do
        %i.fa.fa-arrow-left{ 'aria-hidden': 'true' }
        Previous
      = link_to next_wizard_path, class: 'btn btn-outline-primary' do
        Skip
        %i.fa.fa-arrow-right{ 'aria-hidden': 'true' }
