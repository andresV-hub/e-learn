-# Tarjeta de curso. styles.md §6.1.
-# Orden obligatorio: portada -> título -> profesor -> metadatos -> acción -> estado.
-# Un solo botón principal; las acciones de profesor y administrador van en un
-# pie aparte para no competir con la del estudiante.
.card.el-course-card
  = link_to course_path(course), class: 'el-course-card__cover' do
    - if course.avatar.attached?
      = image_tag course.avatar, alt: course.title
    - else
      .el-course-card__cover--empty
        %i.fa.fa-graduation-cap{ 'aria-hidden': 'true' }

  .card-body
    %h3.el-course-card__title= link_to course.title, course_path(course)

    .el-course-card__teacher
      %i.fa.fa-chalkboard-teacher{ 'aria-hidden': 'true' }
      = link_to course.user.username, user_path(course.user)

    .el-course-card__meta.mb-3
      %span{ title: 'Average rating' }
        %i.fa.fa-star.text-warning{ 'aria-hidden': 'true' }
        = number_with_precision(course.average_rating, precision: 1)
      %span{ title: 'Students enrolled' }
        %i.fa.fa-user-graduate{ 'aria-hidden': 'true' }
        = course.enrollments_count
      %span{ title: 'Lessons' }
        %i.fa.fa-tasks{ 'aria-hidden': 'true' }
        = course.lessons_count

    - progress = course_progress(course)
    - if progress
      .el-progress.mb-3
        .el-progress__bar
          %span.el-progress__fill{ style: "width: #{progress}%",
                                   role: 'progressbar', 'aria-valuenow': progress,
                                   'aria-valuemin': 0, 'aria-valuemax': 100,
                                   'aria-label': "Course progress: #{progress}%" }
        %span.el-progress__label #{progress}% complete

    = enrollment_button(course)

    - if course.tags.any?
      .d-flex.flex-wrap.gap-1.mt-3
        - course.tags.each do |tag|
          %span.el-pill.el-pill--info= tag.name

  - if current_user && policy(course).admin_or_owner?
    .card-footer.bg-white
      .d-flex.flex-wrap.gap-1.mb-2
        = course_status_pills(course)

      - if policy(course).owner?
        .d-flex.flex-wrap.gap-1
          = link_to new_course_lesson_path(course, @lesson), class: 'btn btn-sm btn-outline-primary' do
            %i.fa.fa-plus{ 'aria-hidden': 'true' }
            Lesson
          = link_to course_course_wizard_index_path(course), class: 'btn btn-sm btn-outline-primary' do
            %i.fa.fa-edit{ 'aria-hidden': 'true' }
            Edit
          = link_to analytics_course_path(course), class: 'btn btn-sm btn-outline-primary' do
            %i.fa.fa-chart-bar{ 'aria-hidden': 'true' }
            Analytics
          - if policy(course).destroy?
            = link_to course, data: { turbo_method: :delete, turbo_confirm: "Delete “#{course.title}”? This can't be undone." },
                              class: 'btn btn-sm btn-outline-danger' do
              %i.fa.fa-trash{ 'aria-hidden': 'true' }
              Delete

      - if policy(course).approve?
        .mt-2
          - if course.approved
            = link_to 'Revoke approval', unapprove_course_path(course), data: { turbo_method: :patch }, class: 'btn btn-sm btn-outline-danger'
          - else
            = link_to 'Approve course', approve_course_path(course), data: { turbo_method: :patch }, class: 'btn btn-sm btn-success'
