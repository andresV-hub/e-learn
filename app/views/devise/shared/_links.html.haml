-# Enlaces auxiliares de Devise. styles.md §6 (el-auth__divider, el-social).
-# Los proveedores llevan su icono de marca en lugar de un enlace de texto.
- secondary = []
- secondary << link_to('Log in', new_session_path(resource_name)) if controller_name != 'sessions'
- secondary << link_to('Sign up', new_registration_path(resource_name)) if devise_mapping.registerable? && controller_name != 'registrations'
- secondary << link_to('Forgot your password?', new_password_path(resource_name)) if devise_mapping.recoverable? && controller_name != 'passwords' && controller_name != 'registrations'
- secondary << link_to("Didn't get confirmation instructions?", new_confirmation_path(resource_name)) if devise_mapping.confirmable? && controller_name != 'confirmations'
- secondary << link_to("Didn't get unlock instructions?", new_unlock_path(resource_name)) if devise_mapping.lockable? && resource_class.unlock_strategy_enabled?(:email) && controller_name != 'unlocks'

- if devise_mapping.omniauthable?
  .el-auth__divider or
  - icons = { google_oauth2: 'fab fa-google', github: 'fab fa-github', facebook: 'fab fa-facebook' }
  .el-social
    - resource_class.omniauth_providers.each do |provider|
      = link_to omniauth_authorize_path(resource_name, provider), data: { turbo_method: :post }, class: 'el-social__btn' do
        %i{ class: icons.fetch(provider, 'fa fa-sign-in-alt'), 'aria-hidden': 'true' }
        = "Continue with #{OmniAuth::Utils.camelize(provider)}"

- if secondary.any?
  .text-center.mt-4.d-flex.flex-column.gap-1
    - secondary.each do |link|
      %div= link
