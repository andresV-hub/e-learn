- content_for :title do
  E-Learn | Account settings

.row.justify-content-center
  .col-lg-7
    %header.el-page-header
      .el-page-header__lead
        %span.el-page-header__eyebrow Account
        %h1.el-page-header__title Account settings

    %section.el-panel
      .el-panel__body
        = simple_form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put }) do |f|
          = f.error_notification
          = f.input :email, required: true, autofocus: true
          - if devise_mapping.confirmable? && resource.pending_reconfirmation?
            .alert.alert-info{ role: 'alert' }
              = "Waiting for confirmation of #{resource.unconfirmed_email}"
          = f.input :password, hint: "Leave blank if you don't want to change it", required: false,
                    input_html: { autocomplete: 'new-password' }
          = f.input :password_confirmation, required: false, input_html: { autocomplete: 'new-password' }
          = f.input :current_password, hint: 'We need your current password to confirm the changes',
                    required: true, input_html: { autocomplete: 'current-password' }
          = f.button :submit, 'Update account', class: 'btn btn-primary'

    %section.el-panel
      .el-panel__head
        %h2 Cancel my account
      .el-panel__body
        %p.el-meta Deleting your account removes your enrollments and your progress.
        = link_to 'Cancel my account', registration_path(resource_name),
                  data: { turbo_method: :delete, turbo_confirm: "Delete your account? This can't be undone." },
                  class: 'btn btn-outline-danger'
