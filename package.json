{
  "name": "e-learn",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "build:fonts": "node bin/copy-vendor-fonts.mjs",
    "build:css": "yarn build:fonts && sass ./app/assets/stylesheets/application.scss ./app/assets/builds/application.css --no-source-map --quiet-deps --load-path=node_modules",
    "build:css:watch": "yarn build:fonts && sass --watch --poll ./app/assets/stylesheets/application.scss:./app/assets/builds/application.css --no-source-map --quiet-deps --load-path=node_modules",
    "build": "esbuild app/javascript/application.js --bundle --minify --sourcemap --outdir=app/assets/builds --public-path=/assets",
    "build:watch": "esbuild app/javascript/application.js --bundle --sourcemap --outdir=app/assets/builds --public-path=/assets --watch"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^5.15.4",
    "@popperjs/core": "^2.11.8",
    "@rails/actioncable": "^8.0.0",
    "@rails/actiontext": "^8.0.0",
    "@rails/activestorage": "^8.0.0",
    "@hotwired/turbo-rails": "^8.0.0",
    "bootstrap": "^5.3.8",
    "chart.js": "^3.9.1",
    "chartkick": "^4.2.0",
    "cocoon-js": "^0.0.5",
    "jquery": "^3.7.1",
    "jquery-ui-dist": "^1.13.3",
    "selectize": "^0.12.6",
    "trix": "^2.1.15",
    "video.js": "^7.21.7"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "sass": "^1.83.0"
  }
}
